# =============================================================================
# Helpdesk — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Required (must be set) ---

DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173

# --- Optional (defaults shown) ---

# ENVIRONMENT=development
# SESSION_EXPIRE_HOURS=24
# LOGIN_RATE_LIMIT=5/minute

# --- Email (Resend) ---

# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# FROM_EMAIL="Helpdesk <support@helpdesk.com>"

# --- AI / LLM ---

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-v4-flash
# ANTHROPIC_API_KEY=
# KNOWLEDGE_BASE_PATH=../backend/knowledge-base.md

# --- Webhooks ---

# WEBHOOK_SECRET=

# --- Monitoring ---

# SENTRY_DSN=

# --- Seed Script ---

# ADMIN_EMAIL=admin@helpdesk.com
# ADMIN_PASSWORD=
# AI_AGENT_PASSWORD=
